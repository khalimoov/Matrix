# PostgreSQL — основная БД приложения
POSTGRES_URL=postgresql+psycopg://matrix:matrix@localhost:5432/matrix

# Oracle — источник данных (только чтение).
# DSN в формате host:port/service_name
ORACLE_USER=reader
ORACLE_PASSWORD=secret
ORACLE_DSN=oracle-host:1521/ORCLPDB1

# Размер пачки строк при чтении из Oracle и вставке в PostgreSQL
IMPORT_BATCH_SIZE=5000

# Разрешённые источники для CORS (frontend в режиме разработки)
CORS_ORIGINS=["http://localhost:5173"]
